# Shared .env - works locally (CPU, e.g. 2GB MX450) or on a GPU server
# (e.g. RTX 3060 12GB). Only the Ollama block below needs switching between
# environments; ComfyUI settings are LCM defaults that work either way (slow
# on CPU, fast on GPU) - see notes per section.
#
# Local (CPU only):  docker compose up -d
# Server (with GPU): docker compose -f docker-compose.yml -f docker-compose.gpu.yml up -d
#
# docker compose reads this file automatically - keep it in the same folder
# as docker-compose.yml. Verify what's actually applied at any time with:
#   docker compose config | grep OLLAMA_BASE_URL

# --- Mode -------------------------------------------------------------
DEMO_MODE=false

# --- Database -----------------------------------------------------------
DB_NAME=ai_story_studio
DB_USER=studio
DB_PASSWORD=studio

# --- Ollama (story generation) ------------------------------------------
# TWO WAYS to run Ollama - pick ONE, comment out the other. Neither one runs
# any Ollama install/pull command automatically on startup - just picks
# which Ollama the backend talks to. Pull models yourself, whichever side:
#   ollama pull gemma4:31b-cloud                          (local Ollama)
#   docker compose exec ollama ollama pull gemma4:31b-cloud  (bundled Ollama)
#
# Ollama runs on the host. Docker services connect through host.docker.internal.
COMPOSE_PROFILES=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:31b-cloud
COMPOSE_PROJECT_NAME=ai-story-studio

# ==========================================================================
# IMAGE GENERATION (ComfyUI) - LCM defaults, work on CPU (local) or GPU (server)
# ==========================================================================
COMFYUI_WORKFLOW=character-consistent-story-sdxl
COMFYUI_GPU_VOLUME=ai-story-studio_comfyui-gpu-root

# DreamShaperXL Lightning (SDXL-based, ~7GB) + IPAdapter character
# consistency. Needs, beyond this file:
#   1. models/checkpoints/DreamShaperXL_Lightning.safetensors
#   2. models/ipadapter/ip-adapter-plus_sdxl_vit-h.bin
#   3. ComfyUI_IPAdapter_plus custom node pack installed
#   4. clip_vision_h.safetensors (already have this, shared with Wan)
#   5. A character reference actually generated + locked in Character Studio
#      - IPAdapter has nothing to condition on without one, whichever model.
# WHICHEVER ComfyUI is running (local CPU image vs server GPU image) has its
# own separate model store - same filenames needed in both if you switch
# environments. See COMFYUI_MODEL_DOWNLOAD.md.
COMFYUI_MODEL=DreamShaperXL_Lightning.safetensors
# Optional newer high-quality image model (Qwen Image 2.1) — COMMENTED OUT by default.
# Enable only after installing the matching ComfyUI workflow and model files.
# For RTX 3060 12GB, use the INT8 variant.
# COMFYUI_HQ_WORKFLOW=image_qwen_image_2_1_t2i
# COMFYUI_HQ_MODEL=qwen_image_2.1_int8_convrot.safetensors
# Required supporting files:
#   models/text_encoders/qwen3vl_8b_int8_convrot.safetensors
#   models/vae/qwen_image_2.1_vae_bf16.safetensors

# Lightning checkpoints need low CFG + euler/sgm_uniform, not dpmpp_2m/karras -
# the code auto-corrects this if it sees "lightning" in the checkpoint name,
# but set directly here so what's in this file matches what actually runs.
COMFYUI_STEPS=4
COMFYUI_CFG=2.0
COMFYUI_SAMPLER=euler
COMFYUI_SCHEDULER=sgm_uniform
# SDXL's native resolution, not SD1.5's 512 - going smaller wastes the
# checkpoint's actual quality advantage.
COMFYUI_WIDTH=1024
COMFYUI_HEIGHT=1024
# 600s: comfortable margin either environment. Measured LCM/512 is ~2min/image
# on CPU, seconds on a 12GB GPU - 600s never gets close on either.
COMFYUI_TIMEOUT_SECONDS=600
# 3600, not 1800: on CPU a 12-scene episode can have ~10+ min of images
# queued ahead of the last scene. Costs nothing when the GPU finishes early
# anyway - this only caps how long a scene will WAIT, not how long it takes.
COMFYUI_QUEUE_WAIT_SECONDS=3600
COMFYUI_FALLBACK_PLACEHOLDER=false
# --lowvram only needed below ~4GB (e.g. the 2GB MX450 locally, GPU-mode
# only). Leave empty on the 12GB server card. If you ever run
# docker-compose.gpu.yml on the 2GB laptop instead of CPU mode, set this to
# --lowvram first.
COMFYUI_EXTRA_CLI_ARGS=--reserve-vram 1

# ==========================================================================
# LOCAL AI VIDEO (Wan image-to-video) - real generative motion, GPU only
# ==========================================================================
# 12GB comfortably clears the app's own 4GB floor (LOCAL_AI_ANIMATION_MIN_VRAM_MB) -
# on the local 2GB MX450 this stays unavailable no matter what you set below,
# by design (real VRAM check, not just a flag).
#
# Still needs, beyond these env vars:
#   1. The 3 model files below actually downloaded into the comfyui-gpu-root
#      volume (separate store from the CPU image's comfyui-data volume).
#   2. The ComfyUI-VideoHelperSuite custom node pack installed (not a model -
#      muxes frames into an actual .mp4):
#        docker compose exec comfyui bash -c "cd custom_nodes && git clone https://github.com/Kosinkadink/ComfyUI-VideoHelperSuite"
#        docker compose restart comfyui
# UNVERIFIED, doubly so here: the base wan-image-to-video.json workflow file's
# own comments say it was never run end to end on real hardware, AND it was
# written for the bigger 14B Wan model's node structure (separate CLIP vision
# encoder). TI2V-5B below is the right VRAM tier for 12GB, but its actual
# ComfyUI graph likely needs adjusting (it may not use clip_vision at all) -
# ask before assuming a filename swap alone is enough; verify it completes
# on this exact instance before relying on it for a real episode.
LOCAL_AI_ANIMATION_ENABLED=true
LOCAL_AI_ANIMATION_ENABLED_IN_STORY_PIPELINE=true
# Real bug found via live test: the default workflow name
# (wan-image-to-video, built for the 14B I2V models) does not correctly
# condition on the starting image for the 5B model below - see
# wan-ti2v-5b-image-to-video.json's own comments for the full story. This
# override is required, not optional, for TI2V-5B.
LOCAL_AI_ANIMATION_WORKFLOW=wan-ti2v-5b-image-to-video
# models/diffusion_models/ - Wan 2.2 TI2V-5B (unified text+image-to-video),
# fp8 quant (~5.3GB) - fits 12GB with real headroom, unlike the 14B model
# (26.6GB fp16 / 13GB+ fp8, does not fit a 12GB card).
LOCAL_AI_ANIMATION_MODEL=Wan2_2-TI2V-5B_fp8_e4m3fn_scaled_KJ.safetensors
# models/text_encoders/ - same encoder Wan 2.1 and 2.2 both use.
LOCAL_AI_ANIMATION_CLIP_MODEL=umt5_xxl_fp8_e4m3fn_scaled.safetensors
# models/vae/ - TI2V-5B's OWN vae, NOT wan_2.1_vae.safetensors (that one is
# for the 14B models only - wrong VAE here silently breaks decoding).
LOCAL_AI_ANIMATION_VAE_MODEL=wan2.2_vae.safetensors
# Likely NOT needed for TI2V-5B (see UNVERIFIED note above) - left set in
# case the graph still references it; delete this line if the workflow ends
# up not using a clip_vision input.
LOCAL_AI_ANIMATION_CLIP_VISION_MODEL=clip_vision_h.safetensors
LOCAL_AI_ANIMATION_WIDTH=480
LOCAL_AI_ANIMATION_HEIGHT=832
LOCAL_AI_ANIMATION_FPS=16
LOCAL_AI_ANIMATION_STEPS=16
LOCAL_AI_ANIMATION_CFG=5
LOCAL_AI_ANIMATION_MAX_DURATION_SECONDS=6.0
LOCAL_AI_ANIMATION_MIN_VRAM_MB=14000
LOCAL_AI_ANIMATION_MINIMAX_H3_MIN_VRAM_MB=24000

# Standalone "Video generation" page - how long a finished clip stays
# downloadable before the hourly cleanup sweep deletes it.
VIDEO_GENERATION_RETENTION_HOURS=24

# ==========================================================================
# NARRATION VOICE
# ==========================================================================
# piper = fully offline. edge = free, needs internet, more languages/accents.
# chatterbox = expressive English (paralinguistic tags, voice cloning) - NEW,
#   needs its own profile + a real reference clip, see tts-chatterbox/voices/README.md.
#   Voice Lab and scene narration use the selected local provider directly.
#   Cloned profiles keep their own provider, independent of this default.
# See tts-indic/prompts/README.md for the offline Indic option (--profile indic).
TTS_PROVIDER=chatterbox
TTS_VOICE=en_US-lessac-high
TTS_PRELOAD_VOICES=en_US-lessac-high,en_US-ryan-high
HF_TOKEN=
INDICF5_THREADS=6
SARVAM_API_KEY=
SARVAM_LANGUAGE=en-IN
SARVAM_SPEAKER=anushka
# Only used when TTS_PROVIDER=chatterbox. Must match a reference clip
# filename (minus .wav) in tts-chatterbox/voices/.
CHATTERBOX_VOICE=narrator
CHATTERBOX_DEVICE=cpu
CHATTERBOX_MODEL_TYPE=standard
CHATTERBOX_DEFAULT_LANGUAGE=en

# ==========================================================================
# Quality gate
# ==========================================================================
VIDEO_TRANSITIONS_ENABLED=false
AUTO_MUSIC_ENABLED=true
QUALITY_MIN_SCORE=70
IMAGE_VALIDATION_ENABLED=true
IMAGE_VALIDATION_RETRIES=1
VISION_PROVIDER=mock
VISION_MODEL=llava:latest

# ==========================================================================
# AI VIDEO EDITOR
# ==========================================================================
VIDEO_EDITOR_ENABLED=true
VIDEO_EDITOR_MAX_CONCURRENT_RENDERS=1
VIDEO_EDITOR_MAX_CLIPS=20
VIDEO_EDITOR_MAX_UPLOAD_MB=512
VIDEO_EDITOR_PREVIEW_RESOLUTION=480
VIDEO_EDITOR_DEFAULT_RESOLUTION=1080
VIDEO_ANALYSIS_THREADS=8
VIDEO_EDITOR_X264_PRESET=veryfast
VIDEO_EDITOR_CRF=23
VIDEO_EDITOR_PREVIEW_RETENTION_HOURS=24

# Optional multilingual voice cloning
COSYVOICE_TTS_BASE_URL=http://tts-cosyvoice:5005
COSYVOICE_VOICE=default
COSYVOICE_DEVICE=cpu
# Start with: docker compose --profile cosyvoice up -d --build tts-cosyvoice

# Optional newer/high-quality ComfyUI image workflow. Leave blank to keep v18.3 workflow.
COMFYUI_HQ_WORKFLOW=qwen-image-2-1-16gb-t2i
COMFYUI_HQ_MODEL=qwen_image_2.1_int8_convrot.safetensors
COMFYUI_HQ_STEPS=20
COMFYUI_HQ_WIDTH=576
COMFYUI_HQ_HEIGHT=1024
COMFYUI_HQ_CFG=1.0
COMFYUI_QWEN_DIFFUSION_MODEL=qwen_image_2.1_int8_convrot.safetensors
COMFYUI_QWEN_TEXT_ENCODER=qwen3vl_8b_int8_convrot.safetensors
COMFYUI_QWEN_VAE=qwen_image_2.1_vae_bf16.safetensors
COMFYUI_QWEN_UPSCALE_MODEL=RealESRGAN_x2.pth
COMFYUI_QWEN_RESOLUTION=1024
COMFYUI_QWEN_OUTPUT_WIDTH=864
COMFYUI_QWEN_OUTPUT_HEIGHT=1536
COMFYUI_QWEN_REFERENCE_WORKFLOW=character-consistent-story-ipadapter-sdxl
COMFYUI_QWEN_REFERENCE_MODEL=DreamShaperXL_Lightning.safetensors
