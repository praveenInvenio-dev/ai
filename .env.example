# Copy this file to .env and adjust as needed.
# docker compose automatically reads a .env file in this directory.
#
# IMPORTANT: keep ONE working folder with your .env in it. Extracting each new
# zip into a fresh folder leaves the .env behind, and compose then silently
# falls back to the defaults baked into docker-compose.yml.
# Check what is actually being applied at any time with:
#   docker compose config | findstr COMFYUI      (Windows)
#   docker compose config | grep COMFYUI         (macOS/Linux)

# --- Mode -----------------------------------------------------------------
# DEMO_MODE=true runs the whole pipeline with fast, dependency-free mock
# image/TTS providers so you can try the full UI/workflow without downloading
# any models. Set to false (the default here) once Ollama/ComfyUI/TTS are
# actually reachable, to get real generated images and narration.
DEMO_MODE=false

# --- Database -------------------------------------------------------------
DB_NAME=ai_story_studio
DB_USER=studio
DB_PASSWORD=studio

# --- Ollama (story generation) --------------------------------------------
# By default the backend talks to Ollama running on YOUR machine (outside
# Docker) via host.docker.internal. If Ollama is running elsewhere, point
# this at it instead, e.g.:
#   OLLAMA_BASE_URL=http://192.168.1.20:11434
# If you'd rather run Ollama inside Docker too, start it with
#   docker compose --profile bundled-ollama up -d
# and then set:
#   OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL is just the fallback default model - once the app is running,
# pick any model actually installed on your Ollama server from the dropdown
# on the Create Story screen.
OLLAMA_MODEL=llama3.1

# ==========================================================================
# IMAGE GENERATION (ComfyUI)
# ==========================================================================

COMFYUI_WORKFLOW=character-consistent-story
# Stable Docker volume containing ComfyUI, including existing checkpoints.
# Keep this value unchanged to reuse the existing ai-story-studio model store.
COMFYUI_GPU_VOLUME=ai-story-studio_comfyui-gpu-root

# Must exactly match a filename in ComfyUI's models/checkpoints directory:
#   docker compose exec comfyui ls /root/ComfyUI/models/checkpoints
#
# Base SD1.5 (v1-5-pruned-emaonly) is the reference release, not something
# anyone generates with - a community fine-tune is dramatically better at the
# same cost. DreamShaper 8 LCM is the recommendation here: it has LCM
# distillation baked in, so it is both better AND faster (6 steps, not 25).
# Download it with:
#   docker compose exec comfyui aria2c -c -x4 -d /root/ComfyUI/models/checkpoints \
#     -o DreamShaper8_LCM.safetensors \
#     https://huggingface.co/Lykon/dreamshaper-8-lcm/resolve/main/DreamShaper8_LCM.safetensors
# Verify it is ~2.0G before use - a truncated file gives an opaque safetensors
# parse error rather than saying the download was cut short.
#
# On CPU stay on SD1.5. SDXL is another 5-10x slower again and wants 1024x1024
# to look right, which compounds the problem.
COMFYUI_MODEL=DreamShaper8_LCM.safetensors

# --- 16GB GPU cinematic preset ---------------------------------------------
# Primary image engine: Qwen Image 2.1 INT8. ComfyUI currently documents
# native Qwen Image 2.1 support and the INT8 diffusion/text-encoder pair.
# This preset generates at 576x1024 and uses a lightweight 2x ESRGAN pass,
# then finishes at 864x1536. The prompt enhancer is intentionally OFF because
# its extra 9B text encoder is unnecessary on a 16GB production card.
COMFYUI_HQ_WORKFLOW=qwen-image-2-1-16gb-t2i
COMFYUI_HQ_MODEL=qwen_image_2.1_int8_convrot.safetensors
COMFYUI_HQ_STEPS=20
COMFYUI_HQ_WIDTH=576
COMFYUI_HQ_HEIGHT=1024
COMFYUI_HQ_CFG=1.0
COMFYUI_QWEN_DIFFUSION_MODEL=qwen_image_2.1_int8_convrot.safetensors
COMFYUI_QWEN_TEXT_ENCODER=qwen3vl_8b_int8_convrot.safetensors
COMFYUI_QWEN_VAE=qwen_image_2.1_vae_bf16.safetensors
COMFYUI_QWEN_UPSCALE_MODEL=RealESRGAN_x2.pth
COMFYUI_QWEN_RESOLUTION=1024
COMFYUI_QWEN_OUTPUT_WIDTH=864
COMFYUI_QWEN_OUTPUT_HEIGHT=1536
# Character-reference scenes stay on SDXL + IPAdapter so the reference is
# actually used; the Qwen T2I workflow is for high-detail no-reference scenes.
COMFYUI_QWEN_REFERENCE_WORKFLOW=character-consistent-story-ipadapter-sdxl
COMFYUI_QWEN_REFERENCE_MODEL=DreamShaperXL_Lightning.safetensors

# --- GPU quality preset ----------------------------------------------------
# For an RTX 4090/24GB-class GPU, a much better option than SD1.5 LCM is
# DreamShaper XL Lightning. It is a 6.94GB SDXL checkpoint and its model card
# documents 4-step generation with guidance 2.
# Download: see COMFYUI_MODEL_DOWNLOAD.md
# Then use:
# COMFYUI_MODEL=DreamShaperXL_Lightning.safetensors
# Optional newer high-quality image model (Qwen Image 2.1) — COMMENTED OUT by default.
# Enable only after installing the matching ComfyUI workflow and model files.
# For RTX 3060 12GB, use the INT8 variant.
# COMFYUI_HQ_WORKFLOW=image_qwen_image_2_1_t2i
# COMFYUI_HQ_MODEL=qwen_image_2.1_int8_convrot.safetensors
# Required supporting files:
#   models/text_encoders/qwen3vl_8b_int8_convrot.safetensors
#   models/vae/qwen_image_2.1_vae_bf16.safetensors

# COMFYUI_WORKFLOW=dreamshaper-xl-lightning
# COMFYUI_STEPS=4
# COMFYUI_CFG=2.0
# COMFYUI_SAMPLER=dpmpp_2m
# COMFYUI_SCHEDULER=karras
# COMFYUI_WIDTH=1024
# COMFYUI_HEIGHT=1024

# --- Speed and quality ----------------------------------------------------
# Time for ONE image = STEPS x (seconds-per-step), and seconds-per-step scales
# with WIDTH x HEIGHT. Watch your real rate in `docker compose logs -f comfyui`:
# the progress bar prints "s/it" (seconds per step). On a GPU it flips to
# "it/s", which is the quickest confirmation the GPU is actually being used.
#
# Measured reference points, CPU, SD1.5 at 512x512:
#   1024x576, 30 steps  ->  ~90 s/it  =  ~45 min per image   (unusable)
#    512x512,  8 steps  ->  ~24 s/it  =  ~3.5 min per image  (workable)
#    512x512,  4 steps  ->  ~24 s/it  =  ~2 min per image    (LCM model)
# On a 2 GB GPU the same 6-step job runs in ~40s; on 8 GB+, seconds.
#
# These four go together. An LCM/Turbo/Lightning checkpoint needs the low CFG
# and the lcm sampler - leave CFG at 7 and images come out burnt and
# oversaturated; use a normal sampler at 4-6 steps and you get noise.
COMFYUI_STEPS=4
COMFYUI_CFG=1.0
COMFYUI_SAMPLER=lcm
COMFYUI_SCHEDULER=sgm_uniform
#
# For a plain (non-LCM) SD1.5 checkpoint use these instead:
#   COMFYUI_STEPS=25
#   COMFYUI_CFG=7.0
#   COMFYUI_SAMPLER=dpmpp_2m
#   COMFYUI_SCHEDULER=karras

# 512x512 is SD1.5's native size. FFmpeg upscales to 1080p during video
# assembly anyway, and SD1.5 generates *worse* images above ~768px
# (duplicated heads and limbs), so generating large costs more for less.
COMFYUI_WIDTH=512
COMFYUI_HEIGHT=512

# --- Timeouts -------------------------------------------------------------
# Per-image wall-clock budget. On expiry the backend interrupts and de-queues
# the prompt so it stops consuming CPU that the next scene needs. Set this
# comfortably above STEPS x your measured s/it. Drop to 300 on a GPU.
COMFYUI_TIMEOUT_SECONDS=900
# How long a scene waits its turn while another image generates. Only one
# prompt is ever in flight, so for a 12-scene episode at 4 min each allow at
# least 12 x 240 = 2880s.
COMFYUI_QUEUE_WAIT_SECONDS=3600

# --- CPU tuning (ignored on GPU) ------------------------------------------
# Threads for PyTorch. Set to your PHYSICAL core count, not logical: 12 logical
# processors usually means 6 physical cores, and oversubscribing hyperthreads
# makes diffusion slower. Worth A/B testing - CPU diffusion is memory-bandwidth
# bound, so more threads often does nothing or hurts.
#
# NOTE: this also caps what `nproc` reports inside the container, so
# `docker compose exec comfyui nproc` shows THIS number, not your core count.
COMFYUI_THREADS=4

# EXTRA ComfyUI flags, appended to the mandatory "--cpu --preview-method none"
# that docker-compose.yml sets.
#   --lowvram   required on a 2-4 GB GPU; use --novram if that still OOMs
# Do NOT set COMFYUI_CLI_ARGS - it is deliberately no longer read. It replaced
# the container's own flags wholesale, and any value missing --cpu made ComfyUI
# probe for CUDA and crash-loop with "Torch not compiled with CUDA enabled".
# Delete that key if your .env still has it.
# COMFYUI_EXTRA_CLI_ARGS=--lowvram

# If ComfyUI fails or times out, the pipeline substitutes a placeholder image
# so the rest of the run still completes. Set to false while you are judging
# image quality, so a failure fails the job loudly instead of quietly putting a
# placeholder frame in the finished video.
COMFYUI_FALLBACK_PLACEHOLDER=false

# ==========================================================================
# NARRATION VOICE
# ==========================================================================
# Three engines are available. Preview any of them in the Voice lab (left nav).
#
#   piper  fully offline, free, no key. English, Hindi, Telugu,
#                     Malayalam. NO Kannada, NO Indian English, NO child voices.
#   edge   (built in) free neural voices for Kannada, Hindi, Tamil, Telugu,
#                     Malayalam, Marathi and Indian English. Needs internet.
#                     Unofficial use of Microsoft's browser read-aloud endpoint,
#                     so it can break without warning. Select per voice in the
#                     Voice lab (ids start with "edge:") - no setting needed.
#   indic  (profile)  IndicF5, near-human, MIT-licensed, 11 Indian languages
#                     incl. Kannada. No English. Needs a reference clip and is
#                     slow on CPU. See tts-indic/prompts/README.md.
#                     Start with: docker compose --profile indic up -d tts-indic
#
# Child voices: no engine here has one, so the Voice lab approximates them by
# raising pitch while HOLDING duration (scene lengths derive from the narration
# audio, so a faster-and-higher voice would desync the video).
TTS_PROVIDER=piper
TTS_VOICE=edge:en-IN-NeerjaNeural

# Piper voices download on demand into the tts-data volume. These two preload
# in the background at startup so the Voice lab has something to compare - they
# are Piper's "high" quality models, noticeably smoother than "medium".
TTS_PRELOAD_VOICES=en_US-lessac-high,en_US-ryan-high

# Only for the optional IndicF5 service. ai4bharat/IndicF5 is a gated repo:
# accept the terms at https://huggingface.co/ai4bharat/IndicF5, then paste a
# read token here. The ~1.6 GB model downloads on first synthesis.
HF_TOKEN=
INDICF5_THREADS=6

# Only when TTS_PROVIDER=sarvam (hosted, paid). Key from
# https://dashboard.sarvam.ai - roughly Rs.30 per 10,000 characters, so a
# ~2,500-character episode costs about Rs.7. New accounts get free credits.
# Covers Kannada (kn-IN), Hindi (hi-IN), Indian English (en-IN) and more.
# Speaker names are per-language: check Sarvam's recommended speakers for your
# target language rather than assuming one works everywhere.
SARVAM_API_KEY=
SARVAM_LANGUAGE=en-IN
SARVAM_SPEAKER=anushka

# ==========================================================================
# Quality gate
# ==========================================================================
# --- Production correctness / quality ------------------------------------
# Stable scene-by-scene assembly is the default. Optional xfade transitions are
# automatically rejected if they shorten the expected timeline.
VIDEO_TRANSITIONS_ENABLED=false
# If no music is explicitly selected, choose a calm/adventurous/emotional
# bundled bed automatically and include the exact track in the episode package.
AUTO_MUSIC_ENABLED=true
# Optional semantic image QA. Set to ollama and use a vision model when one is
# installed; mock keeps the pipeline dependency-free.
QUALITY_MIN_SCORE=70
IMAGE_VALIDATION_ENABLED=true
IMAGE_VALIDATION_RETRIES=1
VISION_PROVIDER=mock
VISION_MODEL=llava:latest

# ==========================================================================
# AI VIDEO EDITOR (see VIDEO_EDITOR_ARCHITECTURE.md)
# ==========================================================================
# false removes the module entirely - no endpoints, no nav item - so editor
# problems cannot affect the story pipeline.
VIDEO_EDITOR_ENABLED=true
# 1 is a correctness setting on this hardware, not a tuning knob: concurrent
# x264 encodes alongside a ComfyUI job make everything slower, not faster.
VIDEO_EDITOR_MAX_CONCURRENT_RENDERS=1
VIDEO_EDITOR_MAX_CLIPS=20
VIDEO_EDITOR_MAX_UPLOAD_MB=512
# 480, not 720: ~2.5x faster to encode on 12 CPU cores and adequate for
# judging cuts and timing, which is all a preview is for.
VIDEO_EDITOR_PREVIEW_RESOLUTION=480
VIDEO_EDITOR_DEFAULT_RESOLUTION=1080
VIDEO_ANALYSIS_THREADS=8
# x264 preset for the FINAL render. veryfast on 12 cores beats what a 2 GB
# MX450 offers through NVENC, and avoids a hard CUDA dependency. Previews
# always use ultrafast regardless - they are judged on timing, not quality.
VIDEO_EDITOR_X264_PRESET=veryfast
VIDEO_EDITOR_CRF=23
# Previews are cached by timeline hash, so adjusting cuts leaves a file behind
# per arrangement tried. They are swept after this many hours. Final renders
# persist until their project is deleted.
VIDEO_EDITOR_PREVIEW_RETENTION_HOURS=24

# MiniMax H3 — native local ComfyUI workflow (NOT MiniMax API)
LOCAL_AI_ANIMATION_MINIMAX_H3_MODEL=minimax_h3_fl2va_pruned_int8_convrot.safetensors
LOCAL_AI_ANIMATION_MINIMAX_H3_REF2VA_MODEL=minimax_h3_ref2va_pruned_int8_convrot.safetensors
LOCAL_AI_ANIMATION_MINIMAX_H3_TEXT_ENCODER=qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors
LOCAL_AI_ANIMATION_MINIMAX_H3_VIDEO_VAE=minimax_h3_video_vae_int8_convrot.safetensors
LOCAL_AI_ANIMATION_MINIMAX_H3_AUDIO_VAE=minimax_h3_audio_vae_fp32.safetensors
LOCAL_AI_ANIMATION_MINIMAX_H3_STEPS=8
