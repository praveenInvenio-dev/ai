# =============================================================================
# AI Story Studio - .env (16 GB NVIDIA GPU server)
#   docker compose -f docker-compose.yml -f docker-compose.gpu.yml up -d --build
# Model files: see MODELS.md / ./download-models.sh
# =============================================================================

# --- General -----------------------------------------------------------------
DEMO_MODE=false
COMPOSE_PROJECT_NAME=ai-story-studio
# Starts the tts-chatterbox container (TTS_PROVIDER=chatterbox needs it).
COMPOSE_PROFILES=chatterbox

# --- Database ----------------------------------------------------------------
DB_NAME=ai_story_studio
DB_USER=studio
DB_PASSWORD=change-me

# --- Story LLM (Ollama on the host) ------------------------------------------
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:31b-cloud

# =============================================================================
# IMAGES - Qwen Image 2.1 (single image engine, character refs passed natively)
# =============================================================================
COMFYUI_GPU_VOLUME=ai-story-studio_comfyui-gpu-root
# ComfyUI image: single source of truth for docker-compose.yml AND docker-compose.gpu.yml.
# cu130-slim-v2 = PyTorch 2.13+cu130, for RTX 5060 Ti (Blackwell) + driver 580 / CUDA 13.0.
# Do NOT point this at a cu128/cu124 tag. Check: scripts/validate-comfyui-config.sh
COMFYUI_GPU_IMAGE=yanwk/comfyui-boot:cu130-slim-v2
COMFYUI_QWEN_DIFFUSION_MODEL=qwen_image_2.1_int8_convrot.safetensors
COMFYUI_QWEN_TEXT_ENCODER=qwen3vl_8b_int8_convrot.safetensors
COMFYUI_QWEN_VAE=qwen_image_2.1_vae_bf16.safetensors
COMFYUI_QWEN_UPSCALE_MODEL=RealESRGAN_x2.pth
# Base ~1 MP 9:16, upscaled x2 then resized to 1080x1920.
COMFYUI_QWEN_WIDTH=768
COMFYUI_QWEN_HEIGHT=1344
COMFYUI_QWEN_STEPS=30
COMFYUI_QWEN_RESOLUTION=1024
COMFYUI_QWEN_OUTPUT_WIDTH=1080
COMFYUI_QWEN_OUTPUT_HEIGHT=1920
COMFYUI_TIMEOUT_SECONDS=900
COMFYUI_QUEUE_WAIT_SECONDS=3600
COMFYUI_FALLBACK_PLACEHOLDER=false
# Extra ComfyUI flags, appended after "--preview-method none". Keep EMPTY unless a real
# runtime failure needs one - the cu130 image + DynamicVRAM manage 16 GB themselves.
# Known fallback if Qwen sampling fails with "No operator found for
# memory_efficient_attention_forward ... capability (12, 0) (too new)":
#   COMFYUI_EXTRA_CLI_ARGS=--use-pytorch-cross-attention --disable-xformers
COMFYUI_EXTRA_CLI_ARGS=
# pre-start.sh downloads the Qwen files on first ComfyUI start when true.
DOWNLOAD_16GB_IMAGE_MODELS=true

# =============================================================================
# VIDEO
# =============================================================================
LOCAL_AI_ANIMATION_ENABLED=true
# Story pipeline: false = every scene uses the 2.5D FFmpeg engine (fast).
LOCAL_AI_ANIMATION_ENABLED_IN_STORY_PIPELINE=true
LOCAL_AI_ANIMATION_H3_FOR_ALL_SCENES=true
# Story-pipeline graph: wan-ti2v-5b-image-to-video (fast) or wan22-i2v-a14b (best).
LOCAL_AI_ANIMATION_WORKFLOW=minimax-h3-image-to-video
# One clip (a 10 s H3 clip can take 20-40+ min on a 16 GB card).
LOCAL_AI_ANIMATION_TIMEOUT_SECONDS=5400
LOCAL_AI_ANIMATION_MIN_VRAM_MB=14000

# --- Wan 2.2 TI2V-5B (text or image to video, native 720p@24fps) -------------
LOCAL_AI_ANIMATION_MODEL=Wan2_2-TI2V-5B_fp8_e4m3fn_scaled_KJ.safetensors
LOCAL_AI_ANIMATION_CLIP_MODEL=umt5_xxl_fp8_e4m3fn_scaled.safetensors
LOCAL_AI_ANIMATION_VAE_MODEL=wan2.2_vae.safetensors
# 704x1280 vertical, 1280x704 for wide shots.
LOCAL_AI_ANIMATION_WIDTH=704
LOCAL_AI_ANIMATION_HEIGHT=1280
LOCAL_AI_ANIMATION_FPS=24
LOCAL_AI_ANIMATION_STEPS=30
LOCAL_AI_ANIMATION_CFG=5
LOCAL_AI_ANIMATION_MAX_DURATION_SECONDS=5.0

# --- Wan 2.2 I2V-A14B (best quality, image to video only) --------------------
WAN14B_HIGH_NOISE_MODEL=wan2.2_i2v_high_noise_14B_fp8_scaled.safetensors
WAN14B_LOW_NOISE_MODEL=wan2.2_i2v_low_noise_14B_fp8_scaled.safetensors
WAN14B_VAE=wan_2.1_vae.safetensors
# 480x832 is the safe 16 GB size (832x480 for wide shots).
WAN14B_WIDTH=480
WAN14B_HEIGHT=832
WAN14B_STEPS=20
# true = lightx2v 4-step LoRAs, cfg 1 (~5x faster, slightly softer).
WAN14B_LIGHTNING=false

# --- MiniMax H3 (16gb profile: w6a8 DiT + offload, 480x832, <=5s, 20 steps) --
LOCAL_AI_ANIMATION_MINIMAX_H3_PROFILE=16gb
LOCAL_AI_ANIMATION_MINIMAX_H3_MODEL=minimax_h3_fl2va_pruned_w6a8.safetensors
LOCAL_AI_ANIMATION_MINIMAX_H3_TEXT_ENCODER=qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors
LOCAL_AI_ANIMATION_MINIMAX_H3_VIDEO_VAE=minimax_h3_video_vae_fp16.safetensors
LOCAL_AI_ANIMATION_MINIMAX_H3_AUDIO_VAE=minimax_h3_audio_vae_fp32.safetensors
LOCAL_AI_ANIMATION_MINIMAX_H3_REF2VA_MODEL=minimax_h3_ref2va_pruned_w6a8.safetensors
LOCAL_AI_ANIMATION_MINIMAX_H3_TURBO=true
LOCAL_AI_ANIMATION_MINIMAX_H3_TURBO_STEPS=8
LOCAL_AI_ANIMATION_MINIMAX_H3_TURBO_STRENGTH=1.0
LOCAL_AI_ANIMATION_MINIMAX_H3_TURBO_LORA=minimax_h3_fl2v_turbo_8step_v1.0_comfyui_bf16.safetensors
LOCAL_AI_ANIMATION_MINIMAX_H3_REF2V_TURBO_LORA=minimax_h3_ref2v_turbo_4step_v0.1_comfyui_bf16.safetensors
DOWNLOAD_H3_MODELS=true
# 0 = profile default VRAM floor (15000). -1 = profile RAM floor (48000), 0 = skip.
LOCAL_AI_ANIMATION_MINIMAX_H3_MIN_VRAM_MB=0
LOCAL_AI_ANIMATION_MINIMAX_H3_MIN_RAM_MB=-1
# Longest H3 clip: 10 s (243 frames). 0 = default (10). Lower to 5 if the GPU runs out of memory.
LOCAL_AI_ANIMATION_MINIMAX_H3_MAX_DURATION_SECONDS=10

# Standalone Video Generation page - how long a finished clip stays downloadable.
VIDEO_GENERATION_RETENTION_HOURS=24
# Scene sequences (multi-scene videos) are kept this long.
VIDEO_SEQUENCE_RETENTION_HOURS=72

# =============================================================================
# VOICE
# =============================================================================
TTS_PROVIDER=chatterbox
TTS_VOICE=en_US-lessac-high
TTS_PRELOAD_VOICES=en_US-lessac-high,en_US-ryan-high
# Chatterbox on CPU keeps the 16 GB card free for ComfyUI.
CHATTERBOX_VOICE=narrator
CHATTERBOX_DEVICE=cpu
CHATTERBOX_MODEL_TYPE=standard
CHATTERBOX_DEFAULT_LANGUAGE=en
HF_TOKEN=
INDICF5_THREADS=6
SARVAM_API_KEY=
SARVAM_LANGUAGE=en-IN
SARVAM_SPEAKER=anushka
COSYVOICE_TTS_BASE_URL=http://tts-cosyvoice:5005
COSYVOICE_VOICE=default
COSYVOICE_DEVICE=cpu

# =============================================================================
# QUALITY GATE
# =============================================================================
# Final video format: vertical (1080x1920, default, matches 9:16 images) or horizontal (1920x1080).
VIDEO_ORIENTATION=vertical
VIDEO_TRANSITIONS_ENABLED=false
AUTO_MUSIC_ENABLED=true
QUALITY_MIN_SCORE=70
IMAGE_VALIDATION_ENABLED=true
IMAGE_VALIDATION_RETRIES=1
VISION_PROVIDER=mock
VISION_MODEL=llava:latest

# =============================================================================
# AI VIDEO EDITOR
# =============================================================================
VIDEO_EDITOR_ENABLED=true
VIDEO_EDITOR_MAX_CONCURRENT_RENDERS=1
VIDEO_EDITOR_MAX_CLIPS=20
VIDEO_EDITOR_MAX_UPLOAD_MB=512
VIDEO_EDITOR_PREVIEW_RESOLUTION=480
VIDEO_EDITOR_DEFAULT_RESOLUTION=1080
VIDEO_ANALYSIS_THREADS=8
VIDEO_EDITOR_X264_PRESET=veryfast
VIDEO_EDITOR_CRF=23
VIDEO_EDITOR_PREVIEW_RETENTION_HOURS=24
