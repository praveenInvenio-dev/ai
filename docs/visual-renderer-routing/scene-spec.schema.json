{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Story Studio Visual Scene Spec",
  "type": "object",
  "required": ["sceneId", "narration", "durationSeconds", "engine", "beats"],
  "properties": {
    "sceneId": {"type": "string", "maxLength": 120},
    "narration": {"type": "array", "items": {"type": "string", "maxLength": 2000}},
    "durationSeconds": {"type": "number", "minimum": 0.5, "maximum": 120},
    "engine": {"enum": ["MOTION_CANVAS", "THREE_JS", "MANIM", "RIVE", "NATIVE_DIAGRAM"]},
    "visualGoal": {"type": "string", "maxLength": 400},
    "beats": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "object", "required": ["atSentence", "action"], "properties": {"atSentence": {"type": "integer", "minimum": 0}, "action": {"type": "string", "maxLength": 120}, "targetIds": {"type": "array", "items": {"type": "string", "maxLength": 80}}, "caption": {"type": "string", "maxLength": 180}}}},
    "elements": {"type": "array", "maxItems": 24, "items": {"type": "object", "required": ["id", "kind"], "properties": {"id": {"type": "string", "maxLength": 80}, "kind": {"enum": ["node", "arrow", "label", "code", "particle", "character", "equation", "chart", "asset"]}, "label": {"type": "string", "maxLength": 180}, "x": {"type": "number", "minimum": 0, "maximum": 1}, "y": {"type": "number", "minimum": 0, "maximum": 1}, "assetRef": {"type": "string", "maxLength": 300}}}}
  },
  "additionalProperties": false
}
