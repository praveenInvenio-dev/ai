{
  "_comment": [
    "Fast low-step variant for CPU-only / slow setups.",
    "Requires the LCM-LoRA for your base model in ComfyUI's models/loras directory:",
    "  SD1.5  -> https://huggingface.co/latent-consistency/lcm-lora-sdv1-5   (pytorch_lora_weights.safetensors)",
    "  SDXL   -> https://huggingface.co/latent-consistency/lcm-lora-sdxl",
    "Rename the downloaded file to lcm-lora.safetensors, or edit lora_name in node 10.",
    "Use with COMFYUI_STEPS=6, COMFYUI_CFG=1.5, COMFYUI_SAMPLER=lcm, COMFYUI_SCHEDULER=sgm_uniform.",
    "That is ~4-5x fewer sampling steps than the standard workflow for comparable output."
  ],
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "cfg": "{{CFG}}",
      "denoise": 1,
      "latent_image": ["5", 0],
      "model": ["10", 0],
      "negative": ["7", 0],
      "positive": ["6", 0],
      "sampler_name": "{{SAMPLER}}",
      "scheduler": "{{SCHEDULER}}",
      "seed": "{{SEED}}",
      "steps": "{{STEPS}}"
    }
  },
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "{{CHECKPOINT}}"
    }
  },
  "10": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": ["4", 0],
      "lora_name": "lcm-lora.safetensors",
      "strength_model": 1.0
    }
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "batch_size": 1,
      "height": "{{HEIGHT}}",
      "width": "{{WIDTH}}"
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["4", 1],
      "text": "{{POSITIVE_PROMPT}}"
    }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["4", 1],
      "text": "{{NEGATIVE_PROMPT}}"
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["3", 0],
      "vae": ["4", 2]
    }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "{{FILENAME_PREFIX}}",
      "images": ["8", 0]
    }
  }
}
