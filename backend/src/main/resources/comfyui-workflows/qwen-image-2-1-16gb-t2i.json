{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "{{QWEN_DIFFUSION_MODEL}}",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "{{QWEN_TEXT_ENCODER}}",
      "type": "qwen_image",
      "device": "default"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "{{QWEN_VAE}}"
    }
  },
  "4": {
    "class_type": "QwenImage21Cache",
    "inputs": {
      "model": [
        "1",
        0
      ],
      "device": "auto",
      "dtype": "int8"
    }
  },
  "5": {
    "class_type": "TextEncodeQwenImage21",
    "inputs": {
      "clip": [
        "2",
        0
      ],
