{
  "_comment": [
    "DreamShaper XL Lightning full checkpoint workflow.",
    "Recommended: DreamShaperXL_Lightning.safetensors, 4 steps, CFG 2, dpmpp_2m/karras, 1024x1024.",
    "This is a quality-oriented GPU preset for 8GB+ VRAM; 16-24GB is preferred for comfortable 1024px generation."
  ],
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "cfg": "{{CFG}}", "denoise": 1, "latent_image": ["5", 0], "model": ["4", 0],
      "negative": ["7", 0], "positive": ["6", 0], "sampler_name": "{{SAMPLER}}",
      "scheduler": "{{SCHEDULER}}", "seed": "{{SEED}}", "steps": "{{STEPS}}"
    }
  },
  "4": { "class_type": "CheckpointLoaderSimple", "inputs": { "ckpt_name": "{{CHECKPOINT}}" } },
  "5": { "class_type": "EmptyLatentImage", "inputs": { "batch_size": 1, "height": "{{HEIGHT}}", "width": "{{WIDTH}}" } },
  "6": { "class_type": "CLIPTextEncode", "inputs": { "clip": ["4", 1], "text": "{{POSITIVE_PROMPT}}" } },
  "7": { "class_type": "CLIPTextEncode", "inputs": { "clip": ["4", 1], "text": "{{NEGATIVE_PROMPT}}" } },
  "8": { "class_type": "VAEDecode", "inputs": { "samples": ["3", 0], "vae": ["4", 2] } },
  "9": { "class_type": "SaveImage", "inputs": { "filename_prefix": "ai-story-studio-dreamshaper-xl", "images": ["8", 0] } }
}
