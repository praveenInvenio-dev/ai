{
  "id": "l_cut",
  "name": "L-cut",
  "category": "AUDIO",
  "purpose": "Current shot's audio continues over the next picture, holding continuity across the cut.",
  "minSourceDuration": 1.5,
  "intensity": "subtle",
  "requires": ["currentHasAudio"],
  "incompatibleWith": ["whip_pan"],
  "parameters": { "audioTailSeconds": { "min": 0.2, "max": 1.2, "default": 0.5 } },
  "render": { "kind": "AUDIO_TAIL", "audioTailSeconds": "$audioTailSeconds" }
}
