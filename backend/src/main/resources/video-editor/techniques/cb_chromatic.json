{
  "id": "cb_chromatic",
  "name": "Chromatic aberration",
  "category": "TRANSITION",
  "group": "Creative",
  "purpose": "A fast horizontal smear between shots. Similar look to an RGB-split transition.",
  "minSourceDuration": 0.8,
  "intensity": "dynamic",
  "parameters": {
    "durationSeconds": {
      "min": 0.2,
      "max": 0.8,
      "default": 0.4
    }
  },
  "render": {
    "kind": "XFADE",
    "xfadeTransition": "hblur",
    "durationSeconds": "$durationSeconds"
  }
}
